{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "企业微信记录归档",
  "version": "0.0.2",
  "identifier": "com.torbenxiong.wecomarchive",
  "build": {
    "beforeDevCommand": "pnpm dev:client",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:client",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
